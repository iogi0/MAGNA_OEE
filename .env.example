# Skopírujte do .env a upravte podľa potreby. Súbor .env sa necommituje.

# Relatívne cesty sa rozlišujú voči koreňu projektu (nie voči aktuálnemu priečinku).

# Linka, pre ktorú web hlási a zobrazuje dáta (MVP: jedna linka)
OEE_LINE_ID=L01

# Databáza SQLite (súbor aj priečinok vytvorí aplikácia pri štarte)
OEE_DB_PATH=data/local/oee.db

# Dataset organizátorov (opravená verzia, ST-016 = Kamera / Camera)
OEE_DATASET_PATH=data/raw/dummy_data.xlsx

# Lokálne AI — povolený je LEN localhost / 127.0.0.1 (žiadne cloudové AI API).
# 127.0.0.1 namiesto localhost: na Windows sa localhost môže preložiť na IPv6 ::1, Ollama počúva na IPv4.
OEE_OLLAMA_URL=http://127.0.0.1:11434
OEE_OLLAMA_MODEL=qwen2.5:3b
OEE_AI_ENABLED=true
OEE_AI_LANG=en
OEE_AI_TIMEOUT_S=30
